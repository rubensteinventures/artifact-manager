---
import { env } from 'cloudflare:workers';
import '../styles/global.css';
import '../styles/starwind.css';
import { Button } from '@/components/starwind/button/index.ts';
import { Projector } from 'lucide-astro';
import { getBrandingConfig } from '@/lib/branding';

interface Props {
	title: string;
}

const { title } = Astro.props;
// Auth redirects run in src/middleware.ts so they happen before streaming starts.
const user = await Astro.session?.get('adminUsername');
const branding = getBrandingConfig(
	env as unknown as Record<string, unknown>,
	Astro.url
);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/favicon.svg" />
		<meta name="theme-color" content="#f8fafc" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | {branding.appName}</title>
	</head>
	<body class="bg-slate-50 min-h-screen flex flex-col">
		<nav class="bg-white border-b border-slate-200 px-4 py-3 flex justify-between items-center sticky top-0 z-10">
			<a href="/admin" class="flex items-center gap-2 text-xl font-bold text-slate-900">
				{branding.logoUrl ? (
					<img src={branding.logoUrl} alt={branding.appName} class="h-8 w-auto shrink-0" />
				) : (
					<Projector class="h-8 w-8 shrink-0 text-slate-900" aria-hidden="true" />
				)}
				<span>{branding.appName}</span>
			</a>
			{user && (
				<div class="flex items-center gap-4">
					<span class="text-sm text-slate-600">Admin</span>
					<form action="/admin/api/logout" method="POST">
						<Button variant="outline" size="sm" type="submit">Logout</Button>
					</form>
				</div>
			)}
		</nav>
		<main class="max-w-7xl mx-auto px-4 py-8 w-full flex-1">
			<slot />
		</main>
		<footer class="mt-auto border-t border-slate-200 bg-white py-4 px-4 text-center text-xs text-slate-500">
			{branding.appName}
			<span class="text-slate-400" aria-hidden="true"> · </span>
			<span class="tabular-nums">v{branding.appVersion}</span>
		</footer>
	</body>
</html>
