{
	"name": "artifact-manager",
	"compatibility_date": "2025-04-01",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": true,
	"vars": {
		"APP_NAME": "Presentation Manager",
		"ORG_NAME": "",
		"ORG_URL": "",
		"LOGO_URL": "",
		"HERO_TITLE": "Interactive Presentations",
		"HERO_SUBTITLE": "Explore shared presentations and interactive decks.",
		"PUBLIC_CONTENT_BASE_URL": ""
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "presentations_db",
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "presentation-content"
		}
	],
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "YOUR_KV_NAMESPACE_ID"
		}
	]
}
