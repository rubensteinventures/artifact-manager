---
import { env } from 'cloudflare:workers';
import Layout from '@/layouts/AdminLayout.astro';
import { Card, CardContent, CardHeader, CardTitle, CardDescription } from '@/components/starwind/card/index.ts';
import { Input } from '@/components/starwind/input/index.ts';
import { Button } from '@/components/starwind/button/index.ts';
import { Alert } from '@/components/starwind/alert/index.ts';
import {
	getClientIp,
	checkLoginRateLimit,
	authenticateAdminLogin,
	recordFailedLoginAttempt,
	clearLoginRateLimit,
} from '@/lib/admin-auth';

let error = '';

if (Astro.request.method === 'POST') {
	const clientIp = getClientIp(Astro.request);
	const isRateLimited = await checkLoginRateLimit(env.SESSION, clientIp);

	if (isRateLimited) {
		Astro.response.status = 429;
		error = 'Too many failed login attempts. Please wait a minute and try again.';
	} else {
		const formData = await Astro.request.formData();
		const usernameRaw = formData.get('username');
		const passwordRaw = formData.get('password');
		const username = typeof usernameRaw === 'string' ? usernameRaw.trim() : '';
		const password = typeof passwordRaw === 'string' ? passwordRaw : '';

		const ok = await authenticateAdminLogin(
			env.DB,
			username,
			password,
			env as unknown as Record<string, unknown>
		);

		if (ok) {
			await clearLoginRateLimit(env.SESSION, clientIp);
			await Astro.session?.regenerate();
			Astro.session?.set('adminUsername', username);
			return Astro.redirect('/admin');
		} else {
			await recordFailedLoginAttempt(env.SESSION, clientIp);
			error = 'Invalid username or password';
		}
	}
}
// Logged-in GET /admin/login → /admin is handled in src/middleware.ts
---

<Layout title="Login">
	<div class="flex justify-center items-center py-20">
		<Card class="w-full max-w-md shadow-lg border-slate-200">
			<CardHeader class="space-y-1">
				<CardTitle class="text-2xl text-center">Admin Login</CardTitle>
				<CardDescription class="text-center">Enter your credentials to manage presentations</CardDescription>
			</CardHeader>
			<CardContent>
				<form method="POST" class="space-y-4">
					<div class="space-y-2">
						<label for="username" class="text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70">Username</label>
						<Input id="username" name="username" type="text" required />
					</div>
					<div class="space-y-2">
						<label for="password" class="text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70">Password</label>
						<Input id="password" name="password" type="password" required />
					</div>
					{error && (
						<Alert variant="destructive" class="mt-4">
							{error}
						</Alert>
					)}
					<Button type="submit" class="w-full mt-6" size="lg">Login</Button>
				</form>
			</CardContent>
		</Card>
	</div>
</Layout>
